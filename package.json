{
  "name": "totvibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start": "bun run apps/tui/src/index.tsx",
    "serve": "bun run apps/tui/src/index.tsx --serve",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "bun ./node_modules/vitest/vitest.mjs run",
    "build:sandbox": "./scripts/build_sandbox.py",
    "cz": "node scripts/run-cz.ts"
  },
  "devDependencies": {
    "@totvibe/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@zyplux/cz": "catalog:",
    "@zyplux/eslint-config": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "bun": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
